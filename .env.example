# Copy this file to .env and fill the key locally.
GEMINI_API_KEY=
API_BASE_URL=http://127.0.0.1:8010

GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_DECISION_MODEL=inception/mercury-decide:free
RANK_DECISION_ENABLED=true
OPENROUTER_DECISION_MIN_CONFIDENCE=0.5
RAG_GENERATION_MODEL=gemini-3.5-flash-lite
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_GROQ_MODEL=openai/gpt-oss-20b
RAG_RERANK=false
